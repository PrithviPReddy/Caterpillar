{"nodes": [{"id": "readme_operator_copilot", "label": "Operator Copilot: Smart Operator Assistant", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_construction_site_simulator", "label": "Physics-based Construction Site Simulator", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The provided sample datasets (Data.csv, IIoT set) are sparse, randomly ordered or label-noise, so temporal behaviour cannot be learned from them. The simulator encodes causal physics (load drives heat, clogging reduces cooling, fatigue makes controls jerkier) and records hidden ground truth so ML detection rate, lead time and false alarms can be measured rather than claimed."}, {"id": "readme_detection_layer", "label": "Detection Layer (Rules + ML)", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detectors never see hidden simulator state; every alert is detected from telemetry alone. The layer only consumes the telemetry dict and the plan, so a real machine can be mapped onto the same channel names and retrained with nothing downstream changing."}, {"id": "readme_langgraph_agent", "label": "LangGraph Operator Agent", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept outside this repo (not in requirements.txt) and connected over HTTP (event stream/webhook in, agent messages out), so it can be built against sample events without the simulator; a mock agent stands in until the real graph is connected."}, {"id": "readme_streamlit_cab_display", "label": "Streamlit Operator Cab Display", "file_type": "concept", "source_file": "README.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fastapi_server", "label": "FastAPI Live Replay Server", "file_type": "concept", "source_file": "README.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cause_injection_scenarios", "label": "Cause-Injection Scenarios (No Scripted Alerts)", "file_type": "rationale", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scenarios inject only causes (radiator clogging, surveyor behind counterweight, transmission failure, skipped warm-up) so that every alert must be genuinely detected from telemetry, proving the detection layer rather than scripting its output."}, {"id": "readme_hidden_ground_truth", "label": "Hidden Ground Truth", "file_type": "rationale", "source_file": "README.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded by the simulator but withheld from detectors; it is what allows ML detection rate, lead time and false alarms to be measured objectively."}, {"id": "readme_data_csv", "label": "Data.csv Sample Dataset", "file_type": "concept", "source_file": "README.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sparse, randomly ordered readings; used only for plausible value ranges, not for training temporal models."}, {"id": "readme_iiot_dataset", "label": "IIoT Sample Dataset", "file_type": "concept", "source_file": "README.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent noise with labels that look random; rejected as a training source."}, {"id": "readme_five_levels_of_alert_intelligence", "label": "Five Levels of Alert Intelligence", "file_type": "rationale", "source_file": "README.md", "source_location": "L19-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_l1_threshold", "label": "L1 Threshold Alerts", "file_type": "rationale", "source_file": "README.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_l2_trend", "label": "L2 Trend Alerts", "file_type": "rationale", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_l3_ml_pattern", "label": "L3 ML Pattern (Residual-based Health Models)", "file_type": "rationale", "source_file": "README.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regression models learn what each signal should read for current load, rpm, ambient and warm-up; persistent residuals flag degradation and suggest a cause, catching radiator fouling ~2 h before the fixed alarm and injector wear that thresholds never catch."}, {"id": "readme_l4_predictive", "label": "L4 Predictive Alerts", "file_type": "rationale", "source_file": "README.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_l5_context", "label": "L5 Contextual Alerts", "file_type": "rationale", "source_file": "README.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same reading means different things in different situations (seatbelt off while digging is critical, while parked is info; idle due to truck breakdown is not the operator's fault)."}, {"id": "readme_isolation_forest", "label": "Isolation Forest Model", "file_type": "concept", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ml_training_pipeline", "label": "ML Training Pipeline (ml.train)", "file_type": "concept", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_task_time_estimation_model", "label": "Task Time Estimation Model", "file_type": "concept", "source_file": "README.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained on 5,000 simulated tasks; ~7% error versus ~30% for the planner's rule of thumb."}, {"id": "readme_model_results", "label": "Model Results (Held-out Simulated Days)", "file_type": "concept", "source_file": "README.md", "source_location": "L88-L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_daily_task_dashboard", "label": "Daily Task Dashboard", "file_type": "concept", "source_file": "README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_safety_features", "label": "Safety Monitoring Features", "file_type": "concept", "source_file": "README.md", "source_location": "L32-L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_black_box_recording", "label": "90 s Black-Box Recording", "file_type": "concept", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_unusual_behaviour_detection", "label": "Unusual Behaviour Detection", "file_type": "concept", "source_file": "README.md", "source_location": "L41-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_idle_cause_attribution", "label": "Idle Cause Attribution", "file_type": "rationale", "source_file": "README.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor"