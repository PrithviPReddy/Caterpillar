{"nodes": [{"id": "cocoon_livekit_voice_readme", "label": "livekit-voice README (Cocoon standalone voice assistant Cat)", "file_type": "document", "source_file": "cocoon/livekit-voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_voice_pipeline", "label": "Phase-1 Voice Pipeline (WebRTC -> Krisp -> VAD/Wake -> STT -> Gemini -> TTS)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_assemblyai_stt", "label": "AssemblyAI universal-3-5-pro Streaming STT", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended for English voice agents; supports keyterm prompting (ASSEMBLYAI_KEYTERMS). Hindi/Hinglish not validated."}, {"id": "cocoon_livekit_voice_readme_stt_end_of_turn", "label": "STT-based End-of-Turn Detection (min_turn_silence 160 ms, SDK min_delay 0)", "file_type": "rationale", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single authority for endpointing: SDK would otherwise add 0.3 s min_delay on top of AssemblyAI's endpointing."}, {"id": "cocoon_livekit_voice_readme_gemini_vertex_brain", "label": "Gemini 2.5 Flash on Vertex AI (streaming brain)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen on measured TTFT: 2.5-flash p50 738 ms vs 3.x models much slower/spiky; thinking_budget=0, max_output_tokens=220."}, {"id": "cocoon_livekit_voice_readme_cartesia_tts", "label": "Cartesia sonic-3 Streaming TTS", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_cartesia_access_token_auth", "label": "Cartesia Minted Access-Token Auth (CARTESIA_AUTH=access_token)", "file_type": "rationale", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw API key is rejected with 401 by all Cartesia TTS endpoints though it authenticates /voices and /access-token; minted 1-hour TTS tokens work, refreshed 10 min before expiry."}, {"id": "cocoon_livekit_voice_readme_silero_vad", "label": "Silero VAD", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_krisp_viva_noise", "label": "Krisp VIVA Voice Isolation (worker-side)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VIVA removes competing voices; authenticates through the LiveKit Cloud job JWT; browser noise filtering must stay off to avoid stacking."}, {"id": "cocoon_livekit_voice_readme_wake_gate", "label": "Hey Cat Wake Gate (ARMED/ACTIVE/CLOSED)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact word-bounded leading match with no fuzzy matching so near-misses stay armed; gating via StopResponse before chat history. Not security/authentication."}, {"id": "cocoon_livekit_voice_readme_wake_mode_transcript", "label": "WAKE_MODE=transcript", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works with no model but streams and bills all idle speech to AssemblyAI; not private."}, {"id": "cocoon_livekit_voice_readme_wake_mode_livekit_wakeword", "label": "WAKE_MODE=livekit_wakeword (acoustic wake)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L254", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended acoustic mode: Apache-2.0 ONNX classifier on room audio, dedicated thread (~58-67 ms/inference), 160 ms hop, 600 ms pre-roll."}, {"id": "cocoon_livekit_voice_readme_wake_mode_porcupine", "label": "WAKE_MODE=porcupine", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L272", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternative requiring a Picovoice AccessKey (company email), which the user could not obtain."}, {"id": "cocoon_livekit_voice_readme_adaptive_interruption", "label": "Adaptive Barge-in / Backchannel Detection", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L291", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK-native adaptive model decides barge-in vs backchannel; min_words=0 so 'stop'/'wait' still interrupt; falls back to VAD on detector errors (e.g. 2005 quota exceeded)."}, {"id": "cocoon_livekit_voice_readme_guarded_stream", "label": "guarded_stream: Retry Only Before First Chunk", "file_type": "rationale", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L283", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK LLM retries would replay/restart an answer after partial output, so SDK retries are off and bounded jittered retries happen only before the first chunk; first-chunk timeout 3.5 s, stall 5 s."}, {"id": "cocoon_livekit_voice_readme_thinking_cue", "label": "Thinking Cue (THINKING_CUE_DELAY_MS 1.2 s)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L288", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_phrase_cache", "label": "Cached Fixed Phrases (.cache/tts)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L290", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_remote_langgraph_brain", "label": "VOICE_BRAIN=remote_langgraph Mode", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each final wake-approved utterance becomes one backend turn with turn_id=lk-<chat item id>; only returned speech is spoken; unconfirmed outcome spoken as 'I can't confirm that yet'."}, {"id": "cocoon_livekit_voice_readme_continuous_listening_mode", "label": "Continuous-listening Playground Mode (WAKE_MODE=off, NOISE_CANCELLATION=none)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local diagnostic mode to isolate Krisp event-loop stalls."}, {"id": "cocoon_livekit_voice_readme_manual_playground_checklist", "label": "Manual Playground Checklist (items 1-12, 7a-7h)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_preemptive_generation_disabled", "label": "Preemptive Generation Disabled", "file_type": "rationale", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L304", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowed only for the tool-free phase; must be off for the action-capable backend to avoid speculative side effects."}, {"id": "cocoon_livekit_voice_readme_privacy_logging", "label": "Privacy and Logging Policy", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No transcripts/audio logged by default; secrets shown only as set/MISSING."}, {"id": "cocoon_livekit_voice_readme_doctor", "label": "cocoon_voice.doctor Provider Checks", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_live_probe", "label": "scripts/live_probe.py Synthetic Operator", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_dispatch_helper", "label": "scripts/dispatch.py Dispatch Helper", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_readme_phase0_bridge_tooling", "label": "Phase-0 Bridge Tooling (bridge.py, backend_client.py, announcements.py, mock_backend.py)", "file_type": "concept", "source_file": "cocoon/livekit-voice/README.md", "source_location": "L324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept and tested but not wired into the worker."}], "edges": [{"source": "cocoon_livekit_voice_readme", "target": "cocoon_livekit_voice_readme_voice_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0