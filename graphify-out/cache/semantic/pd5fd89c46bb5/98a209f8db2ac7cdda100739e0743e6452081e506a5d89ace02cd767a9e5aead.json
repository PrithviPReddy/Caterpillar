{"nodes": [{"id": "cocoon_livekit_voice_claude", "label": "livekit-voice CLAUDE.md (team instructions)", "file_type": "document", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_claude_phase_1_standalone_voice", "label": "Phase 1: Standalone Voice Assistant (Cat)", "file_type": "rationale", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded 2026-09-23: ship a self-contained voice experience (AssemblyAI -> Gemini/Vertex -> Cartesia, not LiveKit Inference) and have the user evaluate it before wiring LangGraph; must not claim tasks, incidents, hazards or machine control."}, {"id": "cocoon_livekit_voice_claude_phase_2_langgraph_integration", "label": "Phase 2: LangGraph Backend Integration", "file_type": "rationale", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pending until phase-1 voice is accepted; preemptive generation must be disabled for the action-capable backend."}, {"id": "cocoon_livekit_voice_claude_single_brain_replacement_point", "label": "create_brain() Single Brain Replacement Point", "file_type": "rationale", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid two competing brains/histories: providers.create_brain() is the only place the LLM is chosen; the remote LangGraph adapter must be a streaming llm.LLM returned there, and the LiveKit chat context stays the only conversation history."}, {"id": "cocoon_livekit_voice_claude_cocoon_voice_worker", "label": "Cocoon Voice LiveKit Agents Worker (dispatch name cocoon-voice)", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-lived official LiveKit Agents worker connected to LiveKit Cloud, not a FastAPI handler; explicit dispatch name so it must be dispatched by exact name."}, {"id": "cocoon_livekit_voice_claude_langgraph_agent", "label": "langgraph-agent (sibling backend service)", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_claude_cocoon_app_android", "label": "Cocoon-App Android client (out of scope)", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_claude_http_contract_v1", "label": "Shared HTTP Contract v1 (sessions/turns/events/delivery)", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Services communicate through HTTP JSON only; never import sibling modules or share DB. Contract lives in root contracts/openapi.yaml and API_CONTRACT.md."}, {"id": "cocoon_livekit_voice_claude_stable_turn_id_idempotency", "label": "Stable turn_id Idempotency and 202 Polling", "file_type": "rationale", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One turn_id per logical utterance reused across retries/polling; 200 for completed/duplicate, 202 still processing, 409 on ID reuse with a different payload; never announce success/failure when outcome is unknown."}, {"id": "cocoon_livekit_voice_claude_remote_langgraph_bridge", "label": "Remote LangGraph Bridge (llm_node over HTTP)", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LiveKit's in-process LangGraph adapter is not an HTTP adapter; do not move the backend graph into the worker. Submit each final utterance through exactly one path."}, {"id": "cocoon_livekit_voice_claude_proactive_announcements", "label": "Proactive Announcements (event polling + delivery reports)", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend owns telemetry and alert rules; worker only polls events, speaks them via session.say() and reports played/interrupted/failed/expired only after actual playback. Playback is not acknowledgement or hazard resolution."}, {"id": "cocoon_livekit_voice_claude_mock_backend", "label": "Contract-compatible Mock FastAPI Backend", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets voice work proceed without the backend teammate; must run on a port distinct from 8000 and be unmistakably labeled mock."}, {"id": "cocoon_livekit_voice_claude_vertex_adc_auth", "label": "Vertex AI ADC-only Authentication", "file_type": "rationale", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never read/copy the ADC file or add GOOGLE_API_KEY/GEMINI_API_KEY; project orbit-507316, location global."}, {"id": "cocoon_livekit_voice_claude_one_operator_per_room", "label": "One Operator per Room", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cocoon_livekit_voice_claude_three_voice_milestones", "label": "Three Milestones: Registered / Dispatched / Real Speech", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A registered but undispatched worker has not passed a voice test."}, {"id": "cocoon_livekit_voice_claude_shared_work_tracking", "label": "Shared Work Tracking and Handoff Records", "file_type": "concept", "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "cocoon_livekit_voice_claude", "target": "cocoon_livekit_voice_claude_phase_1_standalone_voice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "cocoon_livekit_voice_claude", "target": "cocoon_livekit_voice_claude_phase_2_langgraph_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "cocoon_livekit_voice_claude", "target": "cocoon_livekit_voice_claude_single_brain_replacement_point", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "cocoon_livekit_voice_claude", "target": "cocoon_livekit_voice_claude_cocoon_voice_worker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "cocoon/livekit-voice/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "cocoon_livekit_voice_claude", "target": "cocoon_livekit_voice_claude_langgraph_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"